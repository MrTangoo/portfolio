# Canonical public URL — used for metadata, sitemap, robots.txt and JSON-LD.
# Defaults to the production domain when unset. Only override to test the
# site under another origin (local dev, tunnels…).
NEXT_PUBLIC_SITE_URL=https://maxime-derbigny.ch

# Optional — Google Search Console verification token. When set, a
# `google-site-verification` meta tag is emitted on every page.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional — "owner/repo" of this repository on GitHub. When set, the
# "Approche" section displays a live CI workflow status badge.
# NEXT_PUBLIC_GITHUB_REPO=MrTangoo/portfolio
