# SMTP Gmail pour le formulaire de contact (/api/contact).
# Nécessite un mot de passe d'application Google (compte avec 2FA activée) :
# https://myaccount.google.com/apppasswords
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=mot-de-passe-application-16-caracteres

# Destinataire des messages du formulaire (par défaut : SMTP_USER).
CONTACT_EMAIL=ton.adresse@gmail.com
